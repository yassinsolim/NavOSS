{
  "name": "@navoss/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/server.ts",
    "lint": "eslint .",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:search:live": "node ./scripts/search-quality.mjs",
    "test:routes:live": "node ./scripts/route-quality.mjs",
    "test:routes:calgary-50": "ROUTE_QUALITY_CASES=./scripts/route-quality-calgary-50.json node ./scripts/route-quality.mjs"
  },
  "dependencies": {
    "@fastify/swagger": "catalog:",
    "@navoss/contracts": "workspace:*",
    "csv-parse": "7.0.2",
    "fastify": "catalog:",
    "fastify-type-provider-zod": "catalog:",
    "openapi-types": "catalog:",
    "pg": "8.23.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
