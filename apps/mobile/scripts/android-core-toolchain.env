# Toolchain for the Android build of the Swift navigation core (docs/architecture/android-core.md).
# Every version and checksum the build depends on lives here; scripts/build-android-core.sh
# sources this file and refuses anything else.

# Swift toolchain, installed with swiftly (which verifies the swift.org signature).
SWIFTLY_VERSION=1.2.0
SWIFT_VERSION=6.4.3

# Swift SDK for Android (swift.org), as installed by `swift sdk install`.
SWIFT_ANDROID_SDK_ID=swift-6.4.3-RELEASE_android
SWIFT_ANDROID_SDK_URL=https://download.swift.org/swift-6.4.3-release/android-sdk/swift-6.4.3-RELEASE/swift-6.4.3-RELEASE_android.artifactbundle.tar.gz
SWIFT_ANDROID_SDK_SHA256=a78839edf4ec161e03b9f1e22a0ef94e565ece3f3ce5c03e3c79246c6b71f0a9

# Target: arm64-v8a, Android 9 (API 28) and later.
SWIFT_ANDROID_TRIPLE=aarch64-unknown-linux-android28
ANDROID_ABI=arm64-v8a

# Android NDK the Swift SDK is linked against (swift.org requires r30). SHA-1 as Google
# publishes it in https://dl.google.com/android/repository/repository2-3.xml.
ANDROID_NDK_VERSION=30.0.16248370
ANDROID_NDK_RELEASE=r30
ANDROID_NDK_LINUX_SHA1=5107f898313790e449e87eee2183d9a20602dee9
ANDROID_NDK_DARWIN_SHA1=c060be96767eefbb8e0a27796d6f43115fc1a0c4
