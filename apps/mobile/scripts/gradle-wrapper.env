# The Gradle distribution the generated Android project's wrapper downloads (expo prebuild writes
# android/gradle/wrapper/gradle-wrapper.properties), pinned by pin-gradle-wrapper.sh. The SHA-256
# is gradle.org's published checksum for the binary-only ZIP: https://gradle.org/release-checksums/
# (also https://services.gradle.org/distributions/gradle-9.3.1-bin.zip.sha256), read 2026-11-23.
# When an Expo/React Native upgrade changes the wrapper's version, the build fails until both
# values here are updated from that page.
GRADLE_VERSION=9.3.1
GRADLE_DISTRIBUTION_SHA256=b266d5ff6b90eada6dc3b20cb090e3731302e553a27c5d3e4df1f0d76beaff06
