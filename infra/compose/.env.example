MAPBOX_ACCESS_TOKEN=
MAPBOX_VEHICLE_LICENSE_CONFIRMED=0
NOMINATIM_DATASET_VERSION=alberta-british-columbia-geofabrik-YYYY-MM-DD
NOMINATIM_DATA_DIR=/srv/navoss/artifacts/nominatim/alberta-british-columbia-YYYY-MM-DD/postgres
NOMINATIM_PBF_PATH=/srv/navoss/artifacts/imports/alberta-british-columbia-YYMMDD.osm.pbf
VALHALLA_DATA_DIR=/srv/navoss/artifacts/valhalla-alberta-british-columbia-YYYY-MM-DD
NOMINATIM_PASSWORD=generate-a-long-random-value
REPORTS_POSTGRES_PASSWORD=generate-a-different-long-random-value
# Community road reports (docs/architecture/community-reports.md).
# shadow = store but never show (code default); attested = beta setting, single attested reports
# are shown as unconfirmed; corroborated = only independently corroborated reports are shown.
COMMUNITY_REPORTS_PUBLICATION=shadow
# Apple Developer Team ID (10 characters). Writes are refused until this and the secret are set.
APP_ATTEST_TEAM_ID=
APP_ATTEST_BUNDLE_ID=org.navoss.mobile
# production for TestFlight/App Store builds; development only for Xcode debug builds.
APP_ATTEST_ENVIRONMENT=production
# enforce (default) accepts App Attest only; allow-development also accepts untrusted simulator keys.
COMMUNITY_ATTESTATION_MODE=enforce
# At least 32 random characters, e.g. `openssl rand -hex 32`. Rotating it orphans all installations.
COMMUNITY_INSTALLATION_SECRET=generate-a-long-random-value-of-at-least-32-characters
# Community traffic from opted-in drivers: off (default), collect (accept and aggregate, publish
# nothing), or live (publish flow). Uploads need an App Attest installation, so the four
# APP_ATTEST_* / COMMUNITY_* values above must be set. See docs/architecture/community-traffic.md.
COMMUNITY_TRAFFIC_MODE=off
# Optional overrides; blank keeps the default. Privacy limits can only be made stricter:
# contributors >= 3, trip trim >= 400 m.
COMMUNITY_TRAFFIC_MIN_CONTRIBUTORS=
COMMUNITY_TRAFFIC_TRIP_TRIM_METERS=
COMMUNITY_TRAFFIC_ROUTE_MIN_COVERAGE=
