{
  "name": "navoss",
  "version": "0.0.0",
  "private": true,
  "description": "Privacy-first, open-source regional navigation.",
  "license": "SEE LICENSES/README.md",
  "homepage": "https://github.com/yassinsolim/NavOSS#readme",
  "bugs": {
    "url": "https://github.com/yassinsolim/NavOSS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassinsolim/NavOSS.git"
  },
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check": "turbo run check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "feedback:counts": "node scripts/feedback-review.mjs counts",
    "feedback:redact": "node scripts/feedback-review.mjs redact",
    "feedback:status": "node scripts/feedback-review.mjs status",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "lint": "turbo run lint",
    "test": "node --test scripts/feedback-workflow.test.mjs scripts/feedback-agent-guard.test.mjs scripts/valhalla-admin-repair.test.mjs scripts/valhalla-speed-profile.test.mjs && turbo run test",
    "validate:navigation:ios": "corepack pnpm --filter @navoss/mobile validate:navigation:ios"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "turbo": "2.10.8",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
