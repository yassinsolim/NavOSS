{
  "$schema": "https://turbo.build/schema.json",
  "agentGuidance": false,
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": [
        "NAVOSS_REQUIRE_TEST_DATABASE",
        "NAVOSS_TEST_DATABASE_URL",
        "NAVOSS_TRAFFIC_TEST_DATABASE_URL"
      ]
    }
  }
}
